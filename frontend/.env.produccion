# ===========================================
# DJ JOSEP FRONTEND - CONFIGURACIÓN DE PRODUCCIÓN
# ===========================================
# ✅ Template para despliegue en producción
# ===== API CONFIGURACIÓN =====
# ⚠️ OBLIGATORIO: Cambiar por tu URL de API real
VITE_API_URL=https://api.djjosepe.com/api
# ===== CONFIGURACIÓN DE PRODUCCIÓN =====
VITE_DEV_MODE=false
VITE_BACKEND_URL=https://api.djjosepe.com
# ===== ANALYTICS =====
# Descomentar y configurar si usas Google Analytics
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
# ===== CONFIGURACIÓN DEL SITIO =====
VITE_SITE_NAME="DJ Josep"
VITE_SITE_DESCRIPTION="Panel de administración de DJ Josep - MySQL Backend"
VITE_SITE_VERSION="1.0.0"
# ===== CONFIGURACIÓN DE SUBIDA DE ARCHIVOS =====
VITE_MAX_FILE_SIZE=10
VITE_ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/gif"
VITE_ALLOWED_AUDIO_TYPES="audio/mpeg,audio/wav,audio/mp3"
# ===== CONFIGURACIÓN DE UI =====
VITE_DEFAULT_THEME="light"
VITE_DEFAULT_LOCALE="es"
# ===== CONFIGURACIÓN DE CACHE =====
VITE_IMAGE_CACHE_TIME=3600
# ===== CONFIGURACIÓN DE DEBUGGING =====
# Deshabilitado en producción
VITE_ENABLE_DEBUG_LOGS=false
# ===========================================
# CHECKLIST ANTES DE DESPLEGAR:
# ===========================================
# ✅ VITE_API_URL apunta a tu servidor real
# ✅ VITE_BACKEND_URL configurado correctamente
# ✅ VITE_DEV_MODE=false
# ✅ VITE_ENABLE_DEBUG_LOGS=false
# ✅ Analytics configurado si se requiere