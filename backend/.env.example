# ===========================================
# DJ JOSEP BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# ✅ ARCHIVO CORREGIDO - Configuración para aplicación monousuario

# ===== CONFIGURACIÓN BÁSICA =====
NODE_ENV=development
PORT=3000

# ===== BASE DE DATOS =====
# Para desarrollo local (SQLite)
DATABASE_URL="file:./src/db/database.sqlite"

# Para producción (PostgreSQL - recomendado)
# DATABASE_URL="postgresql://usuario:password@localhost:5432/djjosep_db"

# ===== SEGURIDAD =====
# Genera una clave secreta fuerte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=15m


# Rate Limiting
RATE_LIMIT_WINDOW=15  # minutos
RATE_LIMIT_MAX=100    # requests por ventana


# ===== CORS - URLs PERMITIDAS =====
# URL del sitio web público
SITE_URL=http://localhost:3000

# URL del panel de administración  
ADMIN_URL=http://localhost:5173

# ===== EMAIL CONFIGURACIÓN =====
# Para envío de notificaciones de contacto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui
SMTP_FROM="DJ Josep Website <noreply@djjosep.com>"

# Email donde recibir mensajes de contacto
CONTACT_EMAIL=admin@djjosep.com

# ===== ARCHIVOS Y UPLOADS =====
# Tamaño máximo de archivos (en MB)
MAX_FILE_SIZE=10

# Directorio de uploads
UPLOAD_DIR=./uploads

# ===== CONFIGURACIÓN DEL SITIO =====
SITE_NAME="DJ Josep"
SITE_DESCRIPTION="Sitio web oficial de DJ Josep"

# ===== ANALYTICS Y LOGGING =====
# Habilitar logging detallado
ENABLE_LOGGING=true

# Retención de datos de analytics (días)
ANALYTICS_RETENTION_DAYS=90

# ===== OPTIMIZACIÓN =====
# Compresión de respuestas
ENABLE_COMPRESSION=true

# Cache headers (en segundos)
STATIC_CACHE_MAX_AGE=86400

# ===== MONITOREO =====
# Para servicios de monitoreo externos
HEALTH_CHECK_SECRET=your_health_check_secret

# ===== CONFIGURACIÓN DE DESARROLLO =====
# Solo para desarrollo - eliminar en producción
DEBUG=true
VERBOSE_LOGGING=true

# ===== CONFIGURACIÓN DE PRODUCCIÓN =====
# Descomentar y configurar para producción
# FORCE_SSL=true
# TRUST_PROXY=true
# SESSION_SECURE=true

# ===== BACKUP Y MANTENIMIENTO =====
# Configuración para backups automáticos
# BACKUP_ENABLED=false
# BACKUP_SCHEDULE="0 2 * * *"  # Diario a las 2 AM
# BACKUP_RETENTION_DAYS=30

# ===========================================
# NOTAS IMPORTANTES:
# ===========================================
# 1. ¡NUNCA subas este archivo con valores reales a git!
# 2. Copia este archivo como .env y rellena con valores reales
# 3. Para JWT_SECRET usa: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 4. Para SMTP_PASS con Gmail, usa App Passwords, no tu contraseña normal
# 5. En producción, usa PostgreSQL en lugar de SQLite
# 6. Configura CORS correctamente con las URLs reales de tu sitio

# ===========================================
# COMANDOS ÚTILES:
# ===========================================
# Generar JWT Secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Inicializar base de datos:
# npm run prisma:migrate
# npm run seed
#
# Ver base de datos:
# npm run prisma:studio
