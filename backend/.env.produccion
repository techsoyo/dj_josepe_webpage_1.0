# ===========================================
# DJ JOSEP BACKEND - CONFIGURACIÓN DE PRODUCCIÓN
# ===========================================
# ✅ Template para despliegue en producción
# ===== CONFIGURACIÓN BÁSICA =====
NODE_ENV=production
PORT=3000
# ===== BASE DE DATOS =====
# PostgreSQL para producción (cambiar credenciales)
DATABASE_URL="postgresql://username:password@localhost:5432/djjosep_production"
# ===== SEGURIDAD =====
# ⚠️ OBLIGATORIO: Generar nuevo JWT_SECRET para producción
# Usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTE_SECRET_EN_PRODUCCION_POR_UNO_GENERADO
# Rate Limiting (más restrictivo en producción)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=60
# ===== CORS - URLs PERMITIDAS =====
# ⚠️ OBLIGATORIO: Cambiar por tus URLs reales
SITE_URL=https://djjosepe.com
ADMIN_URL=https://admin.djjosepe.com
# ===== EMAIL CONFIGURACIÓN =====
# ⚠️ OBLIGATORIO: Configurar con tu servidor SMTP real
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@djjosepe.com
SMTP_PASS=tu_app_password_real_aqui
SMTP_FROM="DJ Josep Website <noreply@djjosepe.com>"
CONTACT_EMAIL=admin@djjosepe.com
# ===== ARCHIVOS Y UPLOADS =====
MAX_FILE_SIZE=10
UPLOAD_DIR=./uploads
# ===== CONFIGURACIÓN DEL SITIO =====
SITE_NAME="DJ Josep"
SITE_DESCRIPTION="Sitio web oficial de DJ Josep"
# ===== ANALYTICS Y LOGGING =====
ENABLE_LOGGING=true
ANALYTICS_RETENTION_DAYS=90
# ===== OPTIMIZACIÓN =====
ENABLE_COMPRESSION=true
STATIC_CACHE_MAX_AGE=86400
# ===== MONITOREO =====
# ⚠️ OBLIGATORIO: Cambiar por un secret seguro
HEALTH_CHECK_SECRET=tu_health_check_secret_seguro_aqui
# ===== CONFIGURACIÓN DE PRODUCCIÓN =====
FORCE_SSL=true
TRUST_PROXY=true
SESSION_SECURE=true
# ===== CONFIGURACIÓN DE DESARROLLO =====
# Deshabilitado en producción
DEBUG=false
VERBOSE_LOGGING=false
# ===== BACKUP Y MANTENIMIENTO =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
# ===========================================
# CHECKLIST ANTES DE DESPLEGAR:
# ===========================================
# ✅ JWT_SECRET generado y único
# ✅ URLs de SITE_URL y ADMIN_URL correctas
# ✅ Credenciales SMTP configuradas
# ✅ DATABASE_URL con PostgreSQL configurado
# ✅ HEALTH_CHECK_SECRET cambiado
# ✅ Backups configurados si se requieren